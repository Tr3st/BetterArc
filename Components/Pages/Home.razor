@page "/"
@inject GammaService Gamma
@inject ScreenScanner Scanner
@using System.Timers
@implements IDisposable
@inject IJSRuntime JS
@using System.Text.Json
@using SharpHook;
@using SharpHook.Native;
@using System.Runtime.InteropServices
@using Microsoft.Win32
@using System.Diagnostics;


<div class="flex h-screen w-full bg-slate-800 text-slate-100 overflow-hidden font-sans border-t-2 border-slate-700">

    <aside class="w-20 bg-slate-700/30 border-r border-slate-600/30 flex flex-col items-center py-8 gap-6 backdrop-blur-xl shrink-0">

        <button @onclick='() => currentTab = "presets"'
                class="p-4 rounded-2xl transition-all duration-300 @(currentTab == "presets" ? "bg-green-500 text-black shadow-[0_0_20px_rgba(34,197,94,0.3)]" : "text-slate-500 hover:bg-white/5 hover:text-slate-300")">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" />
            </svg>
        </button>

        <button @onclick='() => currentTab = "auto"'
                class="p-4 rounded-2xl transition-all duration-300 @(currentTab == "auto" ? "bg-green-500 text-black shadow-[0_0_20px_rgba(34,197,94,0.3)]" : "text-slate-500 hover:bg-white/5 hover:text-slate-300")">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
            </svg>
        </button>

        <div class="flex-1"></div> <button @onclick='() => currentTab = "settings"'
                                           class="p-4 rounded-2xl transition-all duration-300 @(currentTab == "settings" ? "bg-green-500 text-black shadow-[0_0_20px_rgba(34,197,94,0.3)]" : "text-slate-500 hover:bg-white/5 hover:text-slate-300")">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.75a-.426-1.75-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
        </button>
    </aside>

    <main class="flex-1 h-full custom-scrollbar p-6 bg-gradient-to-br from-slate-800 via-slate-700/20 to-slate-800">
        <div class="max-w-2xl mx-auto flex flex-col items-center">

            @if (currentTab == "presets")
            {
                <div class="w-full animate-in fade-in slide-in-from-right-4 duration-500">
                    
                    <div class="text-center mb-10">
                        <h2 class="text-xl font-black tracking-tighter text-slate-100 uppercase italic">Modalità Gamma</h2>
                        <p class="text-[10px] text-emerald-500/70 uppercase tracking-[0.2em] font-bold">Arc Raiders Profiles</p>
                    </div>

                    <div class="grid grid-cols-2 gap-3 mb-6">
                        @foreach (var mode in Modes)
                        {
                            <button @onclick="() => SelectMode(mode)"
                                    class="group relative overflow-hidden p-5 rounded-2xl border-2 transition-all duration-300
                        @(ActiveMode == mode.Name
                                                        ? "bg-emerald-500 border-emerald-400 text-slate-900 shadow-[0_0_25px_rgba(16,185,129,0.4)]" 
                                                        : "bg-slate-800/50 border-slate-700/50 text-slate-300 hover:border-slate-500 hover:bg-slate-800")">

                                <div class="flex flex-col items-start justify-between h-full">
                                    <div class="flex items-center justify-between w-full">
                                        <span class="font-black uppercase italic tracking-tighter text-lg leading-none">@mode.Name</span>

                                        @if (ActiveMode == mode.Name)
                                        {
                                            <div class="w-2 h-2 bg-slate-900 rounded-full animate-pulse"></div>
                                        }
                                    </div>

                                    @if (mode.Name == "Custom" && ActiveMode == "Custom" && !string.IsNullOrEmpty(SelectedProfileName))
                                    {
                                        <span class="text-[9px] font-bold uppercase tracking-widest mt-1 opacity-80 truncate max-w-[120px]">
                                            #@SelectedProfileName
                                        </span>
                                    }
                                </div>
                                <div class="absolute inset-0 bg-gradient-to-tr from-white/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            </button>
                        }
                    </div>

                    <div class="transition-all duration-700 ease-in-out overflow-hidden rounded-[2.5rem]
                @(ActiveMode == "Custom" ? "max-h-[800px] opacity-100 mt-4" : "max-h-0 opacity-0 pointer-events-none")">

                        <div class="p-8 bg-slate-700/20 rounded-[2.5rem] border border-white/5 shadow-2xl backdrop-blur-xl mx-1 mb-1">

                            <div class="flex items-center gap-3 mb-8">
                                <div class="w-1.5 h-4 bg-emerald-500 rounded-full shadow-[0_0_10px_#10b981]"></div>
                                <h3 class="text-xs font-bold uppercase tracking-widest text-slate-300">Configurazione Avanzata</h3>
                            </div>

                            <div class="grid grid-cols-2 gap-x-12 gap-y-6">
                                @for (int i = 0; i < SettingsList.Count; i++)
                                {
                                    var setting = SettingsList[i];
                                    <div class="space-y-2">
                                        <div class="flex justify-between items-center text-[10px] font-bold uppercase text-slate-500">
                                            <span>@setting.Name</span>
                                            <span class="text-emerald-400 font-mono text-xs">@setting.Value%</span>
                                        </div>
                                        <input type="range" min="0" max="100"
                                               value="@setting.Value"
                                               @oninput="(e) => OnSliderChanged(setting, e)"
                                               @onwheel="(e) => OnMouseWheel(setting, e)"
                                               @onwheel:stopPropagation
                                               class="w-full h-1 bg-slate-600 rounded-full appearance-none cursor-pointer accent-emerald-500" />
                                    </div>
                                }
                            </div>

                            <div class="mt-10 flex items-end gap-3">
                                <div class="flex-1">
                                    <label class="text-[9px] uppercase font-black text-slate-500 ml-1 mb-2 block">Saved Profiles</label>
                                    <select @bind="SelectedProfileName"
                                            class="w-full bg-slate-900/50 border border-white/5 text-slate-300 text-[11px] rounded-xl px-4 py-3 appearance-none focus:outline-none focus:border-emerald-500/30">
                                        <option value="">-- Seleziona --</option>
                                        @foreach (var p in SavedProfiles)
                                        {
                                            <option value="@p.Name">@p.Name</option>
                                        }
                                    </select>
                                </div>
                                <button @onclick="OpenSaveDialog"
                                        class="h-[42px] px-6 bg-emerald-500 hover:bg-emerald-400 text-slate-950 rounded-xl font-black text-[10px] uppercase tracking-widest transition-transform active:scale-95 shadow-lg shadow-emerald-500/20">
                                    Salva
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (currentTab == "auto")
            {
                <div class="max-w-md mx-auto animate-in fade-in slide-in-from-right-4 duration-500">
                    <div class="text-center mb-10">
                        <h2 class="text-xl font-black tracking-tighter text-slate-100 uppercase italic">Auto Mode</h2>
                        <p class="text-[10px] text-emerald-500/70 uppercase tracking-[0.2em] font-bold">Smart Visual Optimization</p>
                    </div>

                    <div class="bg-slate-800/40 p-10 rounded-[3rem] border border-white/5 backdrop-blur-xl shadow-2xl w-[500px]">

                        <div class="flex items-center w-full mb-10 px-4">
                            <div class="text-left flex-grow">
                                <h4 class="text-xl font-black text-slate-200 uppercase tracking-tighter leading-none">ALGORITMO ATTIVO</h4>
                                <p class="text-xs text-emerald-500/70 uppercase tracking-[0.2em] font-bold italic mt-2">ADAPTIVE VISION SYSTEM</p>
                            </div>

                            <div class="flex-grow"></div>

                            <div class="shrink-0 ml-16">
                                <button @onclick="() => ToggleAutoBrightness()"
                                        class="w-20 h-10 rounded-full transition-all duration-500 p-1.5 flex items-center relative @(AutoBrightnessActive ? "bg-emerald-500 shadow-[0_0_30px_rgba(16,185,129,0.6)]" : "bg-slate-700")">
                                    <div class="w-7 h-7 bg-white rounded-full shadow-lg transition-transform duration-300 transform @(AutoBrightnessActive ? "translate-x-10" : "translate-x-0")"></div>
                                </button>
                            </div>
                        </div>

                        @if (AutoBrightnessActive)
                        {
                            <div class="space-y-5 pt-8 border-t border-white/10 animate-in fade-in zoom-in-95 duration-300">
                                <div class="flex justify-between items-center font-mono text-sm uppercase tracking-widest">
                                    <span class="text-slate-400">Rilevamento Ombre:</span>
                                    <span class="text-slate-100 font-black">@((currentShadows * 100).ToString("0"))%</span>
                                </div>

                                

                                <div class="flex justify-between items-center font-mono text-sm uppercase tracking-widest">
                                    <span class="text-slate-400">Luminosità Corrente:</span>
                                    <span class="text-emerald-400 font-black">@currentBrightnessValue.ToString("0.00")</span>
                                </div>

                                <div class="flex justify-between items-center font-mono text-sm uppercase tracking-widest">
                                    <span class="text-slate-400">Bilanciamento Contrasto:</span>
                                    <span class="text-slate-100 font-black">@((currentContrast * 100).ToString("0"))%</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (currentTab == "settings")
            {
                <div class="w-full mt-1 space-y-6">
                    <div class="text-center mb-10">
                        <h2 class="text-xl font-black tracking-tighter text-slate-100 uppercase italic">Impostazioni</h2>
                        <p class="text-[10px] text-emerald-500/70 uppercase tracking-[0.2em] font-bold">Scegli le tue preferenze</p>
                    </div>


                    <div class="w-full bg-slate-900/40 p-6 rounded-[2rem] border border-white/5 flex items-center justify-between shadow-xl">
                        <div class="flex flex-col">
                            <span class="text-sm font-black text-white uppercase tracking-tight">Avvio Automatico</span>
                            <span class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">Avvia automaticamente BetterArc all'avvio</span>
                        </div>

                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" checked="@Settings.LaunchAtStartup" @onchange="ToggleStartup" class="sr-only peer">
                            <div class="w-12 h-6 bg-slate-700 rounded-full peer peer-checked:bg-emerald-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-6"></div>
                        </label>
                    </div>

                    <div class="w-full bg-slate-900/40 p-6 rounded-[2rem] border border-white/5 flex items-center justify-between">
                        <div class="flex flex-col">
                            <span class="text-sm font-black text-white uppercase">Riduci nel Tray</span>
                            <span class="text-[10px] text-slate-500 uppercase">Minimizza premendo X</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" checked="@Settings.MinimizeToTrayOnClose" @onchange="ToggleMinimize" class="sr-only peer">
                            <div class="w-12 h-6 bg-slate-700 rounded-full peer peer-checked:bg-emerald-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-6"></div>
                        </label>
                    </div>

                    <div class="w-full bg-slate-900/40 rounded-[2.5rem] border border-white/5 overflow-hidden shadow-2xl">
                        <div class="p-8 border-b border-white/5 flex justify-between items-center bg-white/[0.02]">
                            <div class="flex flex-col">
                                <h3 class="text-sm font-black text-slate-200 uppercase tracking-tight">Scorciatoie Globali</h3>
                                <p class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">Gestisci i tasti rapidi per le modalità</p>
                            </div>
                            <button @onclick="AddNewHotkey" class="bg-emerald-500 hover:bg-emerald-600 text-white px-6 py-3 rounded-2xl text-[10px] font-black transition-all shadow-lg shadow-emerald-500/20 active:scale-95 uppercase tracking-widest">
                                + Aggiungi
                            </button>
                        </div>

                        <div class="w-full overflow-x-auto">
                            <table class="w-full text-left border-separate border-spacing-0">
                                <thead>
                                    <tr class="text-[10px] text-slate-500 uppercase tracking-[0.2em] font-black bg-white/[0.01]">
                                        <th class="px-8 py-5 border-b border-white/5">Modalità Visione</th>
                                        <th class="px-8 py-5 text-center border-b border-white/5">Tasto Rapido</th>
                                        <th class="px-8 py-5 text-right border-b border-white/5">Azioni</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Settings.Hotkeys == null || Settings.Hotkeys.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="3" class="px-8 py-16 text-center text-slate-600 text-[10px] uppercase font-bold tracking-widest italic">
                                                Nessuna scorciatoia configurata
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var hk in Settings.Hotkeys)
                                        {
                                            <tr class="hover:bg-white/[0.02] transition-colors group">
                                                <td class="px-8 py-6 border-b border-white/5">
                                                    <span class="text-xs font-black text-slate-200 uppercase">@hk.ActionName</span>
                                                </td>
                                                <td class="px-8 py-6 text-center border-b border-white/5">
                                                    <kbd class="bg-slate-800 text-emerald-400 px-4 py-2 rounded-xl text-[11px] font-black border border-white/10 shadow-inner inline-block">
                                                        @hk.KeyCombo.Replace("Numpad", "NUM ").Replace("Key", "").Replace("Digit", "")
                                                    </kbd>
                                                </td>
                                                <td class="px-8 py-6 text-right border-b border-white/5">
                                                    <div class="flex justify-end items-center space-x-3">
                                                        <button @onclick="() => EditHotkey(hk)"
                                                                class="flex items-center space-x-2 bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2.5 rounded-xl text-[10px] font-bold transition-all border border-white/5 active:scale-95">
                                                            <span class="material-icons" style="font-size: 16px;">edit</span>
                                                            <span>MODIFICA</span>
                                                        </button>

                                                        <button @onclick="() => { Settings.Hotkeys.Remove(hk); SaveSettings(); }"
                                                                class="flex items-center justify-center bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white w-10 h-10 rounded-xl transition-all border border-red-500/20 active:scale-95">
                                                            <span class="material-icons" style="font-size: 20px;">delete_outline</span>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>
</div>
@if (IsSaveDialogOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-slate-800 border border-slate-600 p-6 rounded-[2rem] shadow-2xl w-80 space-y-4 animate-in zoom-in-95 duration-200">
            <h3 class="text-sm font-bold uppercase text-slate-200 tracking-tight">Nome Profilo</h3>
            <input @bind="NewProfileName" placeholder="Es: Notturno Arc"
                    class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500" />

            <div class="flex gap-2 pt-2">
                <button @onclick="() => IsSaveDialogOpen = false" class="flex-1 py-3 text-xs font-bold text-slate-400 hover:text-white uppercase">Annulla</button>
                <button @onclick="SaveCurrentProfile" class="flex-1 py-3 bg-emerald-500 text-slate-900 rounded-xl text-xs font-bold uppercase">Conferma</button>
            </div>
        </div>
    </div>
}
@if (showHotkeyModal)
{
    <div class="fixed inset-0 bg-black/90 backdrop-blur-sm flex items-center justify-center z-[100] p-4">
        <div class="bg-slate-900 border border-white/10 p-6 rounded-[2rem] w-full max-w-sm shadow-2xl relative">

            <h3 class="text-lg font-black text-white mb-1 uppercase tracking-tighter">Nuova Hotkey</h3>
            <p class="text-[9px] text-emerald-500 uppercase tracking-widest font-bold mb-6">Configura Input</p>

            <div class="space-y-5">
                <div class="space-y-2">
                    <label class="text-[9px] text-slate-500 uppercase font-black tracking-widest ml-1">Azione</label>
                    <select @bind="selectedAction" class="w-full bg-slate-950 border border-white/5 p-3 rounded-xl text-xs text-slate-200 font-bold outline-none focus:border-emerald-500/50 cursor-pointer">
                        @foreach (var action in availableActions)
                        {
                            <option value="@action">@action.ToUpper()</option>
                        }
                    </select>
                </div>

                <div class="bg-black/40 border border-white/5 p-6 rounded-2xl text-center relative">
                    <div class="h-12 flex items-center justify-center">
                        @if (string.IsNullOrEmpty(displayKey))
                        {
                            <p class="text-[10px] text-slate-600 animate-pulse uppercase font-black">In attesa di input...</p>
                        }
                        else
                        {
                            <div class="text-3xl font-black text-emerald-400">@displayKey</div>
                        }
                    </div>

                    <input @onkeydown="HandleKeyDown"
                           @onkeydown:preventDefault="true"
                           class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                           autofocus />
                </div>

                <div class="flex space-x-3 pt-2">
                    <button @onclick="CloseHotkeyModal"
                            class="flex-1 py-3 rounded-xl bg-slate-800 text-slate-400 font-bold text-[9px] uppercase hover:bg-slate-700 transition-all">
                        Annulla
                    </button>
                    <button @onclick="SaveNewHotkey" class="flex-1 py-3 rounded-xl bg-emerald-500 text-black font-bold text-[9px] uppercase hover:bg-emerald-400 disabled:opacity-20 transition-all" disabled="@string.IsNullOrEmpty(detectedKey)">Salva</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // --- VARIABILI DI STATO ---
    private string currentTab = "presets";
    private string ActiveMode = "Normal";
    private bool IsSaveDialogOpen = false;
    private string NewProfileName = "";
    private string _selectedProfileName = "";
    private double currentShadows = 0;

    // --- LOGICA AUTO-BRIGHTNESS ---
    private System.Timers.Timer? _timer;
    private bool AutoBrightnessActive = false;
    private bool isProcessing = false;
    private int uiUpdateCounter = 0;

    private double targetGamma = 1.0;
    private double targetBrightness = 1.0;
    private double currentBrightnessValue = 1.0;
    private double targetContrast = 1.0;
    private double currentContrast = 1.0;
    private double targetVibrance = 1.0;

    // --- HOTKEYS E IMPOSTAZIONI ---
    private bool showHotkeyModal = false;
    private string selectedAction = "Normal";
    private string detectedKey = "";
    private string displayKey = "";
    private List<string> availableActions = new();
    private SimpleGlobalHook? _hook;
    private UserSettings Settings = new();

    // Scorciatoia per accedere ai profili salvati dentro Settings
    private List<UserProfile> SavedProfiles => Settings.SavedProfiles;

    // --- CONFIGURAZIONI FISSE ---
    private List<GammaMode> Modes = new List<GammaMode>
    {
        new GammaMode { Name = "Normal", Gamma = 1.0, Contrast = 1.0, Vibrance = 1.0 },
        new GammaMode { Name = "Bright", Gamma = 1.5, Contrast = 1.1, Vibrance = 1.1 },
        new GammaMode { Name = "Brighter", Gamma = 2.0, Contrast = 1.1, Vibrance = 1.2 },
        new GammaMode { Name = "Custom", Gamma = 1.0, Contrast = 1.0, Vibrance = 1.0 }
    };

    private List<GammaSetting> SettingsList = new()
    {
        new GammaSetting { Name = "Luminosità", Value = 50 },
        new GammaSetting { Name = "Gamma", Value = 50 },
        new GammaSetting { Name = "Contrasto", Value = 50 }
    };

    private void ToggleMinimize(ChangeEventArgs e)
    {
        bool isEnabled = (bool)e.Value;
        Settings.MinimizeToTrayOnClose = isEnabled;
        SaveSettings();
    }


    // --- INIZIALIZZAZIONE E CICLO VITA ---
    protected override void OnInitialized()
    {
        LoadSettings();

        // Setup Timer Auto-Brightness
        _timer = new System.Timers.Timer(30);
        _timer.Elapsed += async (sender, e) =>
        {
            // Se l'auto è spenta o stiamo già lavorando, non fare nulla
            if (!AutoBrightnessActive || isProcessing) return;

            try
            {
                isProcessing = true;
                await OnTimerElapsed();
            }
            finally
            {
                isProcessing = false; // Rilascia sempre il semaforo
            }
        };
        _timer.AutoReset = true;
        _timer.Enabled = true;

        // Setup SharpHook per Hotkeys Globali
        _hook = new SimpleGlobalHook();
        _hook.KeyPressed += async (s, e) => await HandleGlobalHotkey(e.Data.KeyCode.ToString());
        Task.Run(() => _hook.Run());
    }

    public void Dispose()
    {
        AutoBrightnessActive = false;
        _timer?.Stop();
        _timer?.Dispose();
        _hook?.Dispose();
        UpdateGammaSystem(1.0, 1.0, 1.0); // Reset monitor alla chiusura
    }

    // --- GESTIONE HOTKEYS ---
    private async Task HandleGlobalHotkey(string pressedKeyCode)
    {
        // SharpHook restituisce nomi come "VcNumpad1", noi togliamo il "Vc"
        // per farlo combaciare con quello salvato nel Modal ("Numpad1")
        var cleanKey = pressedKeyCode.Replace("Vc", "");

        // Cerchiamo il match
        var match = Settings.Hotkeys.FirstOrDefault(h => h.KeyCombo == cleanKey);

        if (match != null)
        {
            await InvokeAsync(() =>
            {
                var profile = SavedProfiles.FirstOrDefault(p => p.Name == match.ActionName);
                if (profile != null)
                {
                    ApplyProfile(profile);
                }
                else
                {
                    HandleBaseAction(match.ActionName);
                }
                StateHasChanged();
            });
        }
    }

    private void HandleBaseAction(string actionName)
    {
        if (actionName == "Toggle Auto")
        {
            ToggleAutoBrightness();
        }
        else
        {
            var mode = Modes.FirstOrDefault(m => m.Name == actionName);
            if (mode != null) _ = SelectMode(mode);
        }
    }

    // --- APPLICAZIONE PROFILI E FILTRI ---
    private void ApplyProfile(UserProfile profile)
    {
        if (profile == null || profile.Values.Count < 3) return;

        for (int i = 0; i < SettingsList.Count; i++)
            SettingsList[i].Value = profile.Values[i];

        double b = profile.Values[0] / 50.0;
        double g = profile.Values[1] / 50.0;
        double c = profile.Values[2] / 50.0;

        UpdateGammaSystem(g, b, c);
        ActiveMode = "Custom";
        _selectedProfileName = profile.Name;
    }

    private async Task SelectMode(GammaMode mode)
    {
        // 1. Spegniamo categoricamente l'Auto Mode per evitare che sovrascriva i colori
        AutoBrightnessActive = false;

        // 2. Aggiorniamo la UI
        ActiveMode = mode.Name;

        if (mode.Name != "Custom")
        {
            // 3. Applichiamo i valori del preset (es. Normal = 1.0, 1.0, 1.0)
            targetGamma = mode.Gamma;
            targetContrast = mode.Contrast;
            targetVibrance = mode.Vibrance;

            // Reset fisico immediato
            UpdateGammaSystem(targetGamma, 1.0, targetContrast);
        }
        else
        {
            // Se passiamo a Custom, usiamo i valori degli slider
            ApplyAllSettings();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ApplyAllSettings()
    {
        double b = GetValueByName("Luminosità") / 50.0; // 50% -> 1.0
        double g = GetValueByName("Gamma") / 50.0;       // 50% -> 1.0
        double c = GetValueByName("Contrasto") / 50.0;   // 50% -> 1.0
        UpdateGammaSystem(g, b, c);
    }

    // --- PERSISTENZA DATI ---
    private void SaveSettings()
    {
        var json = JsonSerializer.Serialize(Settings);
        Microsoft.Maui.Storage.Preferences.Default.Set("user_settings", json);
    }

    private void LoadSettings()
    {
        var json = Microsoft.Maui.Storage.Preferences.Default.Get("user_settings", "");
        if (!string.IsNullOrEmpty(json))
            Settings = JsonSerializer.Deserialize<UserSettings>(json) ?? new UserSettings();
    }

    private void SaveCurrentProfile()
    {
        if (!string.IsNullOrWhiteSpace(NewProfileName))
        {
            SavedProfiles.RemoveAll(p => p.Name == NewProfileName);
            SavedProfiles.Add(new UserProfile
            {
                Name = NewProfileName,
                Values = SettingsList.Select(s => s.Value).ToList()
            });
            SaveSettings();
            SelectedProfileName = NewProfileName;
            NewProfileName = "";
            IsSaveDialogOpen = false;
        }
    }

    // --- UI EVENT HANDLERS ---
    private void OpenSaveDialog() => IsSaveDialogOpen = true;

    private void ToggleAutoBrightness()
    {
        AutoBrightnessActive = !AutoBrightnessActive;

        if (AutoBrightnessActive)
        {
            // Quando ACCENDI: resetta i valori di partenza per evitare blocchi
            currentBrightnessValue = 1.0;
            currentContrast = 1.0;
            isProcessing = false; // Sblocca il semaforo del timer
        }
        else
        {
            // Quando SPEGNI: resetta istantaneamente il monitor
            UpdateGammaSystem(1.0, 1.0, 1.0);
        }

        StateHasChanged();
    }

    private void AddNewHotkey()
    {
        detectedKey = ""; displayKey = "";
        availableActions = new List<string> { "Normal", "Bright", "Brighter", "Toggle Auto" };
        availableActions.AddRange(SavedProfiles.Select(p => p.Name));
        selectedAction = availableActions.First();
        showHotkeyModal = true;
    }

    private void SaveNewHotkey()
    {
        if (!string.IsNullOrEmpty(detectedKey))
        {
            Settings.Hotkeys.RemoveAll(h => h.ActionName == selectedAction);
            Settings.Hotkeys.Add(new HotkeyMap { ActionName = selectedAction, KeyCombo = detectedKey });
            SaveSettings();
            CloseHotkeyModal();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        // Usiamo e.Code perché è il valore più vicino allo standard SharpHook
        detectedKey = e.Code;

        // Rendiamo il nome bello da vedere nella UI
        displayKey = detectedKey
            .Replace("Numpad", "NUM ")
            .Replace("Key", "")
            .Replace("Digit", "");

        StateHasChanged();
    }

    private void CloseHotkeyModal() { showHotkeyModal = false; detectedKey = ""; displayKey = ""; }

    private void EditHotkey(HotkeyMap hk)
    {
        selectedAction = hk.ActionName;
        detectedKey = hk.KeyCombo;
        displayKey = detectedKey.Replace("Numpad", "NUM ").Replace("Key", "").Replace("Digit", "");
        showHotkeyModal = true;
    }

    private void ToggleStartup(ChangeEventArgs e)
    {
        bool isEnabled = (bool)e.Value;
        Settings.LaunchAtStartup = isEnabled;

        try
        {
            const string appName = "BetterArc";
            string executablePath = Process.GetCurrentProcess().MainModule.FileName;

            using (RegistryKey key = Registry.CurrentUser.OpenSubKey(@"SOFTWARE\Microsoft\Windows\CurrentVersion\Run", true))
            {
                if (isEnabled)
                {
                    // Aggiunge l'avvio automatico nel Registro di Windows
                    key.SetValue(appName, $"\"{executablePath}\"");
                }
                else
                {
                    // Rimuove la voce dal Registro
                    key.DeleteValue(appName, false);
                }
            }

            // Chiamiamo la tua funzione originale per salvare il JSON
            SaveSettings();
        }
        catch (Exception ex)
        {
            // Utile per il debug se il registro è bloccato
            Console.WriteLine($"Errore Auto-Start: {ex.Message}");
        }
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            // Trasformiamo l'oggetto Settings in una stringa JSON
            var json = System.Text.Json.JsonSerializer.Serialize(Settings);

            // Lo salviamo nelle Preferenze di sistema di MAUI
            // Questo è lo stesso "user_settings" che il nostro MauiProgram.cs
            // legge per decidere se minimizzare nel tray.
            Microsoft.Maui.Storage.Preferences.Default.Set("user_settings", json);

            await Task.CompletedTask; // Giusto per rendere il metodo async
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore nel salvataggio settings: {ex.Message}");
        }
    }

    // --- METODI UTILITY ---
    private async Task OnTimerElapsed()
    {
        // 1. Se l'auto è spenta, ESCO SUBITO. Non calcolo nulla.
        if (!AutoBrightnessActive) return;

        try
        {
            // 2. Lettura sensore
            var stats = Scanner.GetDetailedBrightness();
            currentShadows = stats.shadows;

            // 3. Calcolo Target
            if (stats.shadows > 0.12)
            {
                targetBrightness = Math.Min(2.3, 1.0 + (stats.shadows * 0.7));
                targetContrast = 1.0 - (stats.shadows * 0.25);
            }
            else
            {
                targetBrightness = 1.0;
                targetContrast = 1.0;
            }

            // 4. Smoothing (Lerp)
            double speed = 0.08;

            // Se i valori correnti sono assurdi (es. 0), li forziamo a 1.0 per sbloccare lo smoothing
            if (currentBrightnessValue <= 0) currentBrightnessValue = 1.0;

            currentBrightnessValue += (targetBrightness - currentBrightnessValue) * speed;
            currentContrast += (targetContrast - currentContrast) * speed;

            // 5. APPLICAZIONE FISICA (Solo se l'auto è ancora attiva dopo il calcolo)
            if (AutoBrightnessActive)
            {
                UpdateGammaSystem(1.0, currentBrightnessValue, currentContrast);
            }

            // 6. Aggiornamento UI
            uiUpdateCounter++;
            if (uiUpdateCounter >= 3)
            {
                uiUpdateCounter = 0;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore: {ex.Message}");
        }
    }

    private void OnSliderChanged(GammaSetting setting, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            setting.Value = val;
            _selectedProfileName = "";
            ApplyAllSettings();
        }
    }

    private void OnMouseWheel(GammaSetting setting, WheelEventArgs e)
    {
        setting.Value = Math.Clamp(setting.Value + (e.DeltaY < 0 ? 2 : -2), 0, 100);
        _selectedProfileName = "";
        ApplyAllSettings();
    }

    private int GetValueByName(string name) => SettingsList.FirstOrDefault(s => s.Name == name)?.Value ?? 50;

    private string SelectedProfileName
    {
        get => _selectedProfileName;
        set { _selectedProfileName = value; LoadProfile(value); }
    }

    private void LoadProfile(string name)
    {
        var profile = SavedProfiles.FirstOrDefault(p => p.Name == name);
        if (profile != null) ApplyProfile(profile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("preventScrollOnSliders");
    }

    // --- WINAPI E CLASSI ---
    [DllImport("gdi32.dll")] private static extern bool SetDeviceGammaRamp(IntPtr hdc, ref GammaRamp lpRamp);
    [DllImport("user32.dll")] private static extern IntPtr GetDC(IntPtr hWnd);
    [DllImport("user32.dll")] private static extern int ReleaseDC(IntPtr hWnd, IntPtr hDC);

    private void UpdateGammaSystem(double gamma, double brightness, double contrast)
    {
        try
        {
            // Richiamiamo la logica corretta definita in GammaService.cs
            // Passiamo 1.0 come nitidezza e vibrance standard
            Gamma.ApplicaSettaggi(gamma, brightness, contrast, 1.0, 1.0);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore nell'applicazione dei parametri gamma: {ex.Message}");
        }
    }

    [StructLayout(LayoutKind.Sequential)]
    private struct GammaRamp
    {
        [MarshalAs(UnmanagedType.ByValArray, SizeConst = 256)] public ushort[] Red;
        [MarshalAs(UnmanagedType.ByValArray, SizeConst = 256)] public ushort[] Green;
        [MarshalAs(UnmanagedType.ByValArray, SizeConst = 256)] public ushort[] Blue;
    }

    public class UserSettings
    {
        public bool LaunchAtStartup { get; set; }
        public bool MinimizeToTrayOnClose { get; set; }
        public List<HotkeyMap> Hotkeys { get; set; } = new();
        public List<UserProfile> SavedProfiles { get; set; } = new();
        public UserSettings()
        {
            LaunchAtStartup = false;
            MinimizeToTrayOnClose = false;
        }
    }
    public class UserProfile { public string Name { get; set; } = ""; public List<int> Values { get; set; } = new(); }
    public class HotkeyMap { public string ActionName { get; set; } = ""; public string KeyCombo { get; set; } = ""; }
    public class GammaSetting { public string Name { get; set; } = ""; public int Value { get; set; } }
    public class GammaMode { public string Name { get; set; } = ""; public double Gamma { get; set; } = 1.0; public double Contrast { get; set; } = 1.0; public double Vibrance { get; set; } = 1.0; }
}